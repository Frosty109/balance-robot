{
  "permissions": {
    "allow": [
      "Bash(cmake -B build*)",
      "Bash(cmake --build build*)",
      "Bash(ctest *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(sh .agents/sync-claude-skills.sh*)",
      "PowerShell(cmake -B build*)",
      "PowerShell(cmake --build build*)",
      "PowerShell(ctest *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git show*)"
    ],
    "ask": [
      "Edit(/src/**)",
      "Edit(/hal/**)",
      "Edit(/bsp/**)",
      "Edit(/stm32/**)",
      "Edit(/simulation/**)",
      "Edit(/tests/**)",
      "Bash(*--target flash*)",
      "Bash(*openocd*)",
      "PowerShell(*--target flash*)",
      "PowerShell(*openocd*)",
      "Bash(*site_update.py publish*)",
      "PowerShell(*site_update.py publish*)",
      "Bash(git push*)",
      "PowerShell(git push*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && if [ -f tools/switch-check.sh ]; then sh tools/switch-check.sh --hook; else echo '{\"systemMessage\":\"switch-check: tools/switch-check.sh is missing; MEGA may not have delivered tools/ yet\"}'; fi",
            "timeout": 30,
            "statusMessage": "Checking MEGA and git after an OS switch"
          }
        ]
      }
    ]
  }
}
